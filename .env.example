NODE_ENV=development
PORT=5000

# ─────────────────────────────────────────────────────────────
# MongoDB
# Local dev:  mongodb://127.0.0.1:27017/sofahisofa
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/sofahisofa
# ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/sofahisofa

# ─────────────────────────────────────────────────────────────
# JWT Auth — use a long random string in production
# ─────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# ─────────────────────────────────────────────────────────────
# Client / Site URLs
# Production: https://www.thesofahisofa.com
# Local dev:  http://localhost:5173
# ─────────────────────────────────────────────────────────────
CLIENT_URL=https://www.thesofahisofa.com
SITE_URL=https://www.thesofahisofa.com

# ─────────────────────────────────────────────────────────────
# Admin Panel Login Credentials
# Used by: npm run seed  →  creates admin user in MongoDB
# Login URL: http://localhost:5173/admin/login
# Change these before going to production!
# ─────────────────────────────────────────────────────────────
ADMIN_NAME=Sofa Hi Sofa Admin
ADMIN_EMAIL=admin@sofahisofa.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=Admin@SofaHiSofa2026

# ─────────────────────────────────────────────────────────────
# SEO Panel / Tool Credentials
# ─────────────────────────────────────────────────────────────
SEO_EMAIL=seo@sofahisofa.com
SEO_PASSWORD=Seo@SofaHiSofa2026

# ─────────────────────────────────────────────────────────────
# Cloudinary — Product Image Uploads (Admin Panel)
# 1. Sign up free at https://cloudinary.com
# 2. Go to Dashboard → API Keys
# 3. Copy Cloud Name, API Key, and API Secret below
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─────────────────────────────────────────────────────────────
# Razorpay Payments (Optional — for production)
# Get keys from: https://dashboard.razorpay.com/app/keys
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
